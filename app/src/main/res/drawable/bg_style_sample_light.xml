<?xml version="1.0" encoding="utf-8"?>
<!-- Colourful light sample background for the bubble style preview, so glass
     and blur have something to show through. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <gradient
                android:angle="315"
                android:startColor="#FFFDF6E3"
                android:centerColor="#FFE3F2FD"
                android:endColor="#FFFCE4EC" />
        </shape>
    </item>
    <item android:width="90dp" android:height="90dp" android:gravity="top|start"
        android:left="12dp" android:top="8dp">
        <shape android:shape="oval"><solid android:color="#FF81D4FA" /></shape>
    </item>
    <item android:width="70dp" android:height="70dp" android:gravity="bottom|end"
        android:right="20dp" android:bottom="6dp">
        <shape android:shape="oval"><solid android:color="#FFFFB74D" /></shape>
    </item>
    <item android:height="14dp" android:gravity="center_vertical"
        android:left="0dp" android:right="0dp">
        <shape><solid android:color="#FF9575CD" /></shape>
    </item>
</layer-list>
