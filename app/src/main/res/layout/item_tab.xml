<?xml version="1.0" encoding="utf-8"?>
<!-- One tab of the floating tab bar. MainActivity sets the icon, the label
     and the width (tabs share the pill evenly on narrow screens). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="76dp"
    android:layout_height="52dp"
    android:layout_marginStart="2dp"
    android:layout_marginEnd="2dp"
    android:background="@drawable/bg_tab_item"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingStart="4dp"
    android:paddingEnd="4dp"
    android:clickable="true"
    android:focusable="true">

    <ImageView
        android:id="@+id/tab_icon"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:importantForAccessibility="no"
        app:tint="@color/tab_content"
        android:duplicateParentState="true" />

    <TextView
        android:id="@+id/tab_label"
        android:layout_width="match_parent"
        android:layout_height="16dp"
        android:layout_marginTop="2dp"
        android:gravity="center"
        android:maxLines="1"
        android:textAppearance="?attr/textAppearanceLabelSmall"
        android:textColor="@color/tab_content"
        app:autoSizeTextType="uniform"
        app:autoSizeMinTextSize="8sp"
        app:autoSizeMaxTextSize="12sp"
        app:autoSizeStepGranularity="1sp"
        android:duplicateParentState="true" />
</LinearLayout>
