<?xml version="1.0" encoding="utf-8"?>
<!-- Four tab pages stacked in one container (MainActivity shows one at a time)
     under a floating, tinted-blur tab bar. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <!-- Blur source of the tab bar: must not contain it. -->
    <FrameLayout
        android:id="@+id/pages"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <include layout="@layout/page_home" />
        <include layout="@layout/page_style" />
        <include layout="@layout/page_history" />
        <include layout="@layout/page_settings" />
    </FrameLayout>

    <!-- Floating pill: tinted backdrop blur. MainActivity adds the tabs and
         shrinks the pill (and the tabs) on screens narrower than its natural width. -->
    <dev.notune.transcribe.BackdropBlurView
        android:id="@+id/tab_bar"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/tab_bar_height"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="12dp"
        android:elevation="6dp">

        <LinearLayout
            android:id="@+id/tab_items"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingEnd="6dp" />
    </dev.notune.transcribe.BackdropBlurView>
</FrameLayout>
